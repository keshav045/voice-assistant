# =====================================================================
# NEXUS AGENTIC AI PRODUCTIVITY ASSISTANT - ENVIRONMENT CONFIGURATION
# =====================================================================

# App Settings
PROJECT_NAME="Nexus Agentic AI Assistant"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# CORS (JSON string array)
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Security & Authentication
SECRET_KEY="change-this-to-a-secure-random-secret-key-for-jwt-tokens"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Production / Docker PostgreSQL with pgvector:
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/nexus"
# Dev SQLite fallback (if Docker is not running locally):
# DATABASE_URL="sqlite+aiosqlite:///./nexus.db"

# Redis Cache & Task Queue
REDIS_URL="redis://localhost:6379/0"

# OpenAI & AI Services
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"
OPENAI_VOICE_MODEL="gpt-4o-realtime-preview"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# Google Workspace Integration (Phases 5 & 6)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# Desktop Companion Agent (Phase 7)
DESKTOP_AGENT_TOKEN_SECRET="nexus-desktop-agent-secret-token"

