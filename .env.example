# ============================================================
# Nexus AI Personal Voice Assistant - Production Environment Config
# Copy this file to .env and insert your production credentials.
# ============================================================

# --- OpenAI API / Local Ollama Configuration ---
# For 100% free local Ollama inference, use:
#   OPENAI_API_KEY=ollama
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=qwen2.5:1.5b
#   FALLBACK_LLM_MODEL=qwen3:1.7b
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
FALLBACK_LLM_MODEL=
OPENAI_VOICE_MODEL=gpt-4o-realtime-preview
EMBEDDING_MODEL=text-embedding-3-small

# --- Offline Speech Engines (faster-whisper + Piper ONNX + Edge-TTS fallback) ---
WHISPER_MODEL_SIZE=base.en
STT_LANGUAGE=en
WHISPER_BEAM_SIZE=1
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Optional custom prompt vocabulary (unset/none disables prompt bias)
# STT_INITIAL_PROMPT=Nexus AI assistant, WhatsApp, YouTube, Gmail.
PIPER_VOICE=en_US-lessac-medium
PIPER_MODEL_PATH=
# Set STRICT_LOCAL_MODE=true to prevent any cloud STT/TTS fallback (e.g. Edge-TTS / OpenAI audio)
STRICT_LOCAL_MODE=false
# Optional Silero VAD, endpointing, and echo-cancellation warmup tuning
VAD_ACTIVATION_THRESHOLD=0.55
VAD_MIN_SILENCE_DURATION=0.65
MIN_ENDPOINTING_DELAY=0.55
MAX_ENDPOINTING_DELAY=1.5
AEC_WARMUP_DURATION=1.5
ALLOW_INTERRUPTIONS=true
# Optional per-turn voice telemetry JSONL output
VOICE_TELEMETRY_LOG=logs/voice_turns.jsonl
# Optional startup prewarm flags (defaults keep cold-start behaviour unchanged)
PREWARM_OLLAMA=false
PREWARM_STT_DECODE=false

# --- LangSmith Tracing & Observability ---
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=nexus-ai-assistant

# --- Server & Deployment Settings ---
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=false
LOG_LEVEL=info

# --- Database & Persistence ---
# In Docker, use: /app/data/voice_assistant.db
# On local host, use: voice_assistant.db
DB_PATH=voice_assistant.db
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Email (Gmail SMTP Fallback) ---
# How to get SENDER_APP_PASSWORD:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Search for "App Passwords" and generate one for Mail > Windows Computer
#   4. Paste the 16-character code below (spaces are fine, they are ignored)
SENDER_EMAIL=your-gmail@gmail.com
SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Google OAuth 2.0 (Production 1-Click "Connect Gmail" Feature) ---
# Create at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- LiveKit WebRTC Voice Engine (Sub-500ms Real-Time Streaming) ---
# Create free account at https://cloud.livekit.io
# Generate API Keys in Project Settings > Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxx
LIVEKIT_API_SECRET=your_secret_here

