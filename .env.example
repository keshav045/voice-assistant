# ============================================================
# Nexus AI Personal Voice Assistant - Production Environment Config
# Copy this file to .env and insert your production credentials.
# ============================================================

# --- OpenAI API Configuration (Required) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_VOICE_MODEL=gpt-4o-realtime-preview
EMBEDDING_MODEL=text-embedding-3-small

# --- Server & Deployment Settings ---
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=false
LOG_LEVEL=info

# --- Database & Persistence ---
# In Docker, use: /app/data/voice_assistant.db
# On local host, use: voice_assistant.db
DB_PATH=voice_assistant.db
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Email (Gmail SMTP Fallback) ---
# How to get SENDER_APP_PASSWORD:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Search for "App Passwords" and generate one for Mail > Windows Computer
#   4. Paste the 16-character code below (spaces are fine, they are ignored)
SENDER_EMAIL=your-gmail@gmail.com
SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Google OAuth 2.0 (Production 1-Click "Connect Gmail" Feature) ---
# Create at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- LiveKit WebRTC Voice Engine (Sub-500ms Real-Time Streaming) ---
# Create free account at https://cloud.livekit.io
# Generate API Keys in Project Settings > Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxx
LIVEKIT_API_SECRET=your_secret_here

