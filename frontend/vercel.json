{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "http://localhost:8000/api/:match*"
    },
    {
      "source": "/health",
      "destination": "http://localhost:8000/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

