# Backend Environment Variables
PROJECT_NAME="Nexus Agentic AI Assistant"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# CORS
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Auth & Security
SECRET_KEY="nexus-dev-secret-key-change-in-production-min-32-chars-length"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL with pgvector or SQLite for local dev without Docker)
DATABASE_URL="sqlite+aiosqlite:///./nexus.db"
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/nexus"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI Models
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_VOICE_MODEL="gpt-4o-realtime-preview"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

